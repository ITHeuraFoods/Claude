#!/bin/bash
# Emite, lista y revoca tokens de acceso a los MCP de Heura (fase 05).
# El fichero guarda solo el SHA-256: si alguien pierde su token, se revoca y
# se emite otro, no se puede recuperar.
set -euo pipefail
MAP=/etc/heura-mcp/tokens.map
umask 022
touch "$MAP"

case "${1:-}" in
  add)
    EMAIL="$(echo "${2:?uso: heura-mcp-token add <email>}" | tr "[:upper:]" "[:lower:]")"
    if grep -qi ":$EMAIL\$" "$MAP"; then
      echo "ERROR: $EMAIL ya tiene token. Revocalo primero: heura-mcp-token revoke $EMAIL" >&2
      exit 1
    fi
    TOKEN="$(openssl rand -hex 32)"
    echo "$(printf %s "$TOKEN" | sha256sum | cut -d" " -f1):$EMAIL" >> "$MAP"
    echo
    echo "  Identidad : $EMAIL"
    echo "  Token     : $TOKEN"
    echo
    echo "  Se muestra UNA sola vez. Va en el .mcp.json de esa persona:"
    echo '    "headers": { "Authorization": "Bearer '"$TOKEN"'" }'
    echo
    ;;
  list)
    echo "Identidades con token:"
    cut -d: -f2 "$MAP" | grep -v "^#" | sed "s/^/  /" || true
    ;;
  revoke)
    EMAIL="$(echo "${2:?uso: heura-mcp-token revoke <email>}" | tr "[:upper:]" "[:lower:]")"
    sed -i "/:$EMAIL\$/d" "$MAP"
    echo "revocado: $EMAIL"
    ;;
  *)
    echo "uso: heura-mcp-token {add <email>|list|revoke <email>}" >&2
    exit 1
    ;;
esac
