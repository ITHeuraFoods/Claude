# =============================================================================
#  Tunel IPsec  srv-mcp (Hetzner, Helsinki)  <->  FW-ES-HHQ-02 (Heura, BCN)
#  strongSwan 6.0 - sintaxis swanctl. En esta version NO existe ipsec.conf.
#  Ver runbook de migracion a Hetzner, fase 02.
#
#  Un ajuste por linea: "auth = psk ; id = x" en la misma linea NO es valido,
#  el parser se come el resto de la linea como valor de auth y descarta todo.
#
#  Dos hijos sobre la misma SA, ambos con origen unico 10.99.0.10 (dummy0):
#  UN SOLO hijo con remote_ts 0.0.0.0/0: cubre tanto SAP (10.3.2.48) como la
#  salida a Internet, y casa 1:1 con el phase 2 comodin del FortiGate. NO anadir
#  un hijo especifico para SAP: los selectores se solapan, y como solo hay una SA
#  de vuelta el trafico entrante choca con la politica XFRM mas especifica y el
#  kernel lo descarta silenciosamente (out sube, in se queda a 0).
#   - internet : salida por Heura, para que Microsoft geolocalice ES
#                y las dos politicas de MFA del tenant sigan en notApplied
# =============================================================================

connections {
    heura {
        version      = 2
        local_addrs  = 65.108.55.155
        remote_addrs = 90.160.153.130
        proposals    = aes256-sha256-modp2048
        rekey_time   = 86400s
        dpd_delay    = 20s
        encap        = no

        local {
            auth = psk
            id   = 65.108.55.155
        }
        remote {
            auth = psk
            id   = 90.160.153.130
        }

        children {
            internet {
                local_ts      = 10.99.0.10/32
                remote_ts     = 0.0.0.0/0
                esp_proposals = aes256-sha256-modp2048
                life_time     = 43200s
                start_action  = trap
                close_action  = restart
                dpd_action    = restart
            }
        }
    }
}

secrets {
    ike-heura {
        id-1   = 65.108.55.155
        id-2   = 90.160.153.130
        secret = "PON_AQUI_EL_PSK"  # se genera en el servidor, NUNCA se versiona
    }
}
