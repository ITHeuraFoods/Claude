[Unit]
Description=Heura - MCP de Graph/M365
Documentation=https://github.com/ITHeuraFoods/Claude
After=network-online.target strongswan.service
Wants=network-online.target

[Service]
Type=simple
User=mcpgraph
Group=mcpgraph
WorkingDirectory=/opt/heura-mcp/graph
EnvironmentFile=/etc/heura-mcp/graph.env
ExecStart=/opt/heura-mcp/.venv/bin/python -u /opt/heura-mcp/graph/run_graph.py
Restart=always
RestartSec=5

# Endurecimiento: solo puede escribir en su directorio de tokens.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
CapabilityBoundingSet=
SupplementaryGroups=mcpauth
ReadWritePaths=/var/lib/heura-mcp/tokens /var/lib/heura-mcp/auth

[Install]
WantedBy=multi-user.target
